#
# golang-fips-toolchain.env — authoritative version pin for the golang-fips/go
# toolchain used in FIPS-path builds.
#
# This file is the single source of truth for the golang-fips/go release to use.
# The Dockerfile fips-path-builder stage reads GOLANG_FIPS_VERSION as a build-arg
# (default matches this value) so the two are kept in sync.
#
# HOW TO UPDATE
# =============
# 1. Check the latest release at https://github.com/golang-fips/go/releases
# 2. Update GOLANG_FIPS_VERSION and GOLANG_FIPS_COMMIT_REF below.
# 3. Update GOLANG_FIPS_SOURCE_DIGEST by running:
#      curl -fsSL "https://github.com/golang-fips/go/archive/refs/tags/go${GOLANG_FIPS_VERSION}.tar.gz" | sha256sum
# 4. Run: make fips-path-build
# 5. Run: make check-fips-path
#
# Do NOT change the GOLANG_FIPS_BASE_GO_VERSION or GOLANG_FIPS_VERSION to a
# value not associated with an active NIST CMVP certificate. See
# FIPS-140-3-COMPLIANCE.md §2a for the approved module list.
#
# WARNING: "latest" is not a valid value — version and digest must be explicit.

# golang-fips/go release tag (without leading "go").
# Format: <base-go-version>-<release-sequence>
# Example: 1.22.5-1 corresponds to github.com/golang-fips/go tag go1.22.5-1
GOLANG_FIPS_VERSION=1.22.5-1

# The standard Go base version embedded in this golang-fips/go release.
# Used to cross-check that the FIPS toolchain's Go version matches .go-version.
GOLANG_FIPS_BASE_GO_VERSION=1.22.5

# Git tag at github.com/golang-fips/go.
GOLANG_FIPS_COMMIT_REF=go1.22.5-1

# SHA-256 of the golang-fips/go source archive for this release.
# Obtained via:
#   curl -fsSL https://github.com/golang-fips/go/archive/refs/tags/go1.22.5-1.tar.gz | sha256sum
# Set to "unverified" only during initial provisioning; must be set before merging.
GOLANG_FIPS_SOURCE_DIGEST=unverified

# GitHub release base URL for the golang-fips/go tarball.
# The detect-golang-fips-toolchain.sh script uses this to construct download URLs.
GOLANG_FIPS_RELEASE_BASE_URL=https://github.com/golang-fips/go/releases/download

# OpenSSL FIPS provider package name in the glibc build environment.
# Must be the FIPS-validated OpenSSL package for the target distribution.
OPENSSL_FIPS_PACKAGE=openssl

# Expected minimum OpenSSL version for FIPS-path builds.
# Operators must verify the exact version against the NIST CMVP active module list.
OPENSSL_FIPS_MIN_VERSION=3.0
